#include "Base.xcconfig"

ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)

// Origin of the API, without a path: the spec's paths already start with /api/v1.
// www, because trackdown.nl answers every call with a 308 to www.trackdown.nl.
// Override in Secrets.xcconfig to point Debug builds at a local or preview API.
TRACKDOWN_API_BASE_URL = https:/$()/www.trackdown.nl

// Sent as the `environment` property, so dashboards can leave Debug builds out.
POSTHOG_ENVIRONMENT = development

// Last, so local values override everything above. `#include?` skips a missing file.
#include? "Secrets.xcconfig"
