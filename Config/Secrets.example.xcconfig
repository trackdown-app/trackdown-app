// Copy to Config/Secrets.xcconfig (untracked) and fill in real values:
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Values here override Debug.xcconfig and Release.xcconfig.
// Remember `//` starts a comment: write URLs as https:/$()/host/path.

// Sent as the `Trackdown-Client-Key` header on every API call.
TRACKDOWN_CLIENT_KEY =

// Enable after deploying the backend in observe mode. Simulator builds need a
// separate client key that the server does not require App Attest for.
// TRACKDOWN_APP_ATTEST_ENABLED = YES

// PostHog project token. Leave empty to disable analytics locally.
POSTHOG_PROJECT_TOKEN =

// Apple Developer team id, needed only for device builds.
DEVELOPMENT_TEAM =

// Optional: point Debug builds at another API. Origin only, no /api/v1 path.
// TRACKDOWN_API_BASE_URL = http:/$()/localhost:5173
