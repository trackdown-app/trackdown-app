#include "Base.xcconfig"

VALIDATE_PRODUCT = YES
TRACKDOWN_APP_ATTEST_ENVIRONMENT = production
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O

// Origin of the API, without a path: the spec's paths already start with /api/v1.
// www, because trackdown.nl answers every call with a 308 to www.trackdown.nl.
TRACKDOWN_API_BASE_URL = https:/$()/www.trackdown.nl

// Sent as the `environment` property on every event.
POSTHOG_ENVIRONMENT = production

// Last, so local values override everything above. `#include?` skips a missing file.
#include? "Secrets.xcconfig"
