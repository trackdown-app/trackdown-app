{
  "sourceLanguage" : "en",
  "strings" : {
    "tripLine.accessibilityLabel" : {
      "comment" : "VoiceOver label of a guess: station name, trip time, how the trip changes trains. Example: \"Maastricht, 2 hours, 25 minutes, change at a hidden station\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, %3$@"
          }
        }
      }
    },
    "tripSummary.changeAt" : {
      "comment" : "Trip summary under a guess: the trip changes trains once, at this station.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change at %@"
          }
        }
      }
    },
    "tripSummary.changeAt.spoken" : {
      "comment" : "VoiceOver, after the station and trip time: the trip changes trains once, at this station.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "change at %@"
          }
        }
      }
    },
    "tripSummary.changes" : {
      "comment" : "Trip summary under a guess: the trip changes trains this many times (2 or more).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld change"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes"
                }
              }
            }
          }
        }
      }
    },
    "tripSummary.direct" : {
      "comment" : "Trip summary under a guess: the trip needs no change of trains.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct"
          }
        }
      }
    },
    "tripSummary.direct.spoken" : {
      "comment" : "VoiceOver, after the station and trip time: the trip needs no change of trains.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "direct"
          }
        }
      }
    },
    "tripSummary.hiddenChange" : {
      "comment" : "Trip summary under a guess: the trip changes trains once, at a station the player has not guessed yet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change at a hidden station"
          }
        }
      }
    },
    "tripSummary.hiddenChange.spoken" : {
      "comment" : "VoiceOver, after the station and trip time: the trip changes trains once, at a station not guessed yet.",
      "extractionState" : "manual",
      "localizations" : {
