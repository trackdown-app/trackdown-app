    "tripLine.accessibilityLabel" : {
      "comment" : "VoiceOver label of a guess: station name, trip time, how the trip changes trains. Example: \"Maastricht, 2 hours, 25 minutes, change at a hidden station\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, %2$@, %3$@" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, %2$@, %3$@" } }
      }
    },
    "tripSummary.changeAt" : {
      "comment" : "Trip summary under a guess: the trip changes trains once, at this station.",
