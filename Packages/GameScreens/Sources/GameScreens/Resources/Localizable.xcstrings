    },
    "Belgium" : {
      "comment" : "Rail network still to come.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "België" } }
      }
    },
    "Best" : {
      "comment" : "Statistic: the longest streak so far.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Beste" } }
      }
    },
    "Check your connection and try again." : {
      "comment" : "Description when the puzzle cannot load without a connection.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Controleer je verbinding en probeer het opnieuw." } }
      }
    },
    "Choose network" : {
      "comment" : "Title of the network picker.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Kies een netwerk" } }
      }
    },
    "Closest guess: **%@**, %@ away." : {
      "comment" : "On the Missed sheet. The arguments are the guessed station closest to the answer and its trip time, such as \"17 minutes\".",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dichtstbijzijnde gok: **%1$@**, op %2$@ afstand." } }
      }
    },
    "Coming next" : {
      "comment" : "Header above the rail networks still to come.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Binnenkort" } }
      }
    },
    "Continue" : {
      "comment" : "Archive row button that goes back to today's puzzle.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Verder" } }
      }
    },
    "Each network has its own daily station and its own streak." : {
      "comment" : "Introduction under the title of the network picker.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Elk netwerk heeft zijn eigen station van de dag en zijn eigen reeks." } }
      }
    },
    "Every past %@ station. Play the ones you missed, or look back at how you did." : {
      "comment" : "Introduction under the Archive title. The argument is a network, such as Netherlands.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Alle eerdere stations van %@. Speel de puzzels die je hebt gemist, of kijk terug hoe het ging." } }
      }
    },
    "Germany" : {
