{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld guesses" : {
      "comment" : "VoiceOver label of a chart row of games solved in this many guesses, more than one.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "%lld gokken" } }
      }
    },
    "%lldh%@" : {
      "comment" : "A trip time in a shared result, such as 2h25. The arguments are hours and the minutes, padded to two digits.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "%1$lldu%2$@" } }
      }
    },
    "1 guess" : {
      "comment" : "VoiceOver label of the chart row of games solved in one guess.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "1 gok" } }
      }
    },
    "Best" : {
      "comment" : "Statistic: the longest streak so far.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Beste" } }
      }
    },
    "Check your connection and try again." : {
      "comment" : "Description when the puzzle cannot load without a connection.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Controleer je verbinding en probeer het opnieuw." } }
      }
    },
    "Choose network" : {
      "comment" : "Title of the network picker.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Kies een netwerk" } }
      }
    },
    "Closest guess: **%@**, %@ away." : {
      "comment" : "On the Missed sheet. The arguments are the guessed station closest to the answer and its trip time, such as \"17 minutes\".",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dichtstbijzijnde gok: **%1$@**, op %2$@ afstand." } }
      }
    },
    "Great Britain" : {
      "comment" : "Rail network name in the network pill.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Groot-Brittannië" } }
      }
    },
    "Guess %lld" : {
      "comment" : "VoiceOver label of a guess's number.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gok %lld" } }
      }
    },
    "Guesses needed" : {
      "comment" : "Heading of the chart of how many guesses each game took.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Benodigde gokken" } }
      }
    },
    "https://trackdown.nl/en/%@" : {
      "comment" : "Link at the end of a shared result: the network's game in the app's language. Dutch drops the /en. The argument is the network, such as nl.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "https://trackdown.nl/%@" } }
      }
    },
    "Loading puzzle" : {
      "comment" : "Shown while today's puzzle loads.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Puzzel laden" } }
      }
    },
    "Loading the answer" : {
      "comment" : "VoiceOver label while the mystery station loads.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het antwoord wordt geladen" } }
      }
    },
    "Loading your record" : {
      "comment" : "VoiceOver label while the statistics load.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je record wordt geladen" } }
      }
    },
    "Missed" : {
      "comment" : "Chart row of the games that ran out of guesses.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gemist" } }
      }
    },
    "Mystery station" : {
      "comment" : "Label above the bars that stand for the mystery station.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Mysteriestation" } }
      }
    },
    "Netherlands" : {
      "comment" : "Rail network name in the network pill.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Nederland" } }
      }
    },
    "Next station in %@" : {
      "comment" : "Under the Share button: the time until the next puzzle, such as 13:42:08.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Volgend station over %@" } }
      }
    },
    "Not tracked down" : {
      "comment" : "Shared result of a game that ran out of guesses.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Niet gevonden" } }
      }
    },
    "Older puzzles" : {
      "comment" : "Missed sheet button that opens the archive.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Eerdere puzzels" } }
      }
    },
    "Out of guesses. The station was" : {
      "comment" : "Above the mystery station on the Missed sheet. The station's name follows on its own line.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Geen gokken meer. Het station was" } }
      }
    },
    "Played" : {
      "comment" : "Statistic: games finished.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gespeeld" } }
      }
    },
    "Puzzle %lld, guess %lld of %lld" : {
      "comment" : "Under the day on the playing screen: the puzzle number and which guess is being made.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Puzzel %1$lld, gok %2$lld van %3$lld" } }
      }
    },
    "Results" : {
      "comment" : "Title of the sheet with a finished game's results.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Resultaat" } }
      }
    },
    "See results" : {
      "comment" : "Button under a finished game that opens its results.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Bekijk resultaat" } }
      }
    },
    "Share" : {
      "comment" : "Missed sheet button that shares the result.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Delen" } }
      }
    },
    "Share result" : {
      "comment" : "Solved sheet button that shares the result.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deel je resultaat" } }
      }
    },
    "Shows the trip ride by ride" : {
      "comment" : "VoiceOver hint of a guess: tapping it opens its trip ride by ride.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Toont de reis rit voor rit" } }
      }
    },
    "Something went wrong" : {
      "comment" : "Title when the puzzle failed to load.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Er ging iets mis" } }
      }
    },
    "Streak" : {
      "comment" : "Statistic: puzzles solved on their day in a row.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Reeks" } }
      }
    },
    "That's not a station on this network." : {
      "comment" : "A guess for an unknown station.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dat is geen station op dit netwerk." } }
      }
    },
    "The answer didn't load." : {
      "comment" : "On the results sheet when the mystery station could not be loaded.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het antwoord kwam niet door." } }
      }
    },
    "The puzzle couldn't be loaded. Try again in a moment." : {
      "comment" : "Description when the puzzle failed to load.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De puzzel kon niet worden geladen. Probeer het zo opnieuw." } }
      }
    },
    "This version of the app is no longer supported. Update it from the App Store." : {
      "comment" : "Description when the app version is no longer supported.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deze versie van de app wordt niet meer ondersteund. Werk hem bij via de App Store." } }
      }
    },
    "Too many guesses. Try again in %@." : {
      "comment" : "Rate-limited guess. The argument is a wait such as \"30 seconds\".",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Te veel gokken. Probeer het over %@ opnieuw." } }
      }
    },
    "Too many requests" : {
      "comment" : "Title when the server asks the app to wait.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Te veel verzoeken" } }
      }
    },
    "Tracked down in %lld of %lld" : {
      "comment" : "Above the mystery station on the Solved sheet: how many guesses it took, of how many.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gevonden in %1$lld van %2$lld" } }
      }
    },
    "Tracked down in %lld" : {
      "comment" : "Shared result of a solved game. The argument is how many guesses it took.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gevonden in %lld" } }
      }
    },
    "Try again" : {
      "comment" : "Retries loading the puzzle.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Probeer opnieuw" } }
      }
    },
    "Try again in %@." : {
      "comment" : "Description when rate limited. The argument is a wait such as \"30 seconds\".",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Probeer het over %@ opnieuw." } }
      }
    },
    "Update Trackdown" : {
      "comment" : "Title when the app version is no longer supported.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Werk Trackdown bij" } }
      }
    },
    "Update Trackdown to keep playing." : {
      "comment" : "The server no longer accepts this version of the app.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Werk Trackdown bij om verder te spelen." } }
      }
    },
    "Won" : {
      "comment" : "Statistic: the share of games solved.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gewonnen" } }
      }
    },
    "You already guessed %@." : {
      "comment" : "A guess for a station guessed before. The argument is the station's name.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je hebt %@ al geraden." } }
      }
    },
    "You're offline" : {
      "comment" : "Title when the puzzle cannot load without a connection.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je bent offline" } }
      }
    },
    "You're offline. Your guess wasn't sent." : {
      "comment" : "A guess that could not reach the server.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je bent offline. Je gok is niet verstuurd." } }
      }
    },
    "Your guess couldn't be sent. Try again." : {
      "comment" : "A guess that failed on the server.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je gok kon niet worden verstuurd. Probeer het opnieuw." } }
      }
    },
    "Your record didn't load." : {
      "comment" : "On the results sheet when the statistics could not be loaded.",
      "localizations" : {
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je record kwam niet door." } }
      }
    }
  },
  "version" : "1.0"
}
